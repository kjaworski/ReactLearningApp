# Copy to .env and adjust. Read by NestJS (ConfigModule) and the Prisma CLI.

# PostgreSQL from docker-compose.yml
DATABASE_URL="postgresql://finance:finance_dev@localhost:5432/finance_db?schema=public"

# JWT authentication
# Use a long random secret, e.g.: node -p "require('node:crypto').randomBytes(32).toString('base64')"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
