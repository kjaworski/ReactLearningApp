# Copy to .env and adjust. Read by the Next.js server at runtime.

# Where the Next.js server reaches the API: server-side fetches and the dev-only rewrite of /api/*.
# The browser never uses it - it calls /api on the web app's own origin (docs/architecture.md ADR-19).
# Not NEXT_PUBLIC_: those are baked in at build time, and one image must run in every environment.
API_URL="http://localhost:3001"
